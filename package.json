{
    "name": "gargoyle",
    "main": "src/index.ts",
    "type": "module",
    "dependencies": {
        "@discordjs/voice": "^0.19.0",
        "@snazzah/davey": "^0.1.9",
        "canvas": "^3.2.1",
        "discord.js": "^14.25.1",
        "drizzle-orm": "^0.45.1",
        "fs": "^0.0.2",
        "ollama": "^0.6.3",
        "opusscript": "^0.1.1",
        "path": "^0.12.7",
        "pg": "^8.20.0",
        "steamapi": "^3.1.5",
        "tsconfig-paths": "^4.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.8",
        "@types/figlet": "^1.7.0",
        "@types/node": "^25.2.0",
        "@types/pg": "^8.18.0",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.9",
        "eslint": "^10.0.3",
        "globals": "^17.3.0",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "scripts": {
        "start": "bun run .",
        "db:generate": "bunx drizzle-kit --config ./drizzle.config.ts generate",
        "db:migrate": "bunx drizzle-kit --config ./drizzle.config.ts migrate",
        "dev": "bun run --watch .",
        "dev:on": "bun run aux:on && bun run app:on",
        "dev:off": "bun run aux:off && bun run app:off",
        "aux:on": "docker compose --env-file ./.env -f ./docker-compose-dev.yml --profile aux up --build -d --remove-orphans ",
        "aux:off": "docker compose -f ./docker-compose-dev.yml --profile aux down --remove-orphans",
        "app:on": "docker compose --env-file ./.env -f ./docker-compose-dev.yml --profile app up --build  --remove-orphans ",
        "app:off": "docker compose -f ./docker-compose-dev.yml --profile app down --remove-orphans",
        "build": "tsc",
        "format": "prettier --write \"src/**\"",
        "check": "bun run format && bun run build"
    },
    "prettier": {
        "endOfLine": "lf",
        "printWidth": 150,
        "bracketSpacing": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "useTabs": false,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2,
                    "useTabs": false
                }
            }
        ]
    }
}
