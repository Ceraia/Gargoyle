{
    "name": "gargoyle",
    "main": "src/index.ts",
    "type": "module",
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@snazzah/davey": "^0.1.11",
        "canvas": "^3.2.3",
        "discord.js": "^14.26.3",
        "drizzle-orm": "^0.45.2",
        "fs": "^0.0.2",
        "ollama": "^0.6.3",
        "opusscript": "^0.1.1",
        "path": "^0.12.7",
        "pg": "^8.20.0",
        "steamapi": "^3.1.5",
        "tsconfig-paths": "^4.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.12",
        "@types/figlet": "^1.7.0",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "10.2.0",
        "globals": "^17.5.0",
        "prettier": "^3.8.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.58.2"
    },
    "scripts": {
        "start": "bun run .",
        "db:generate": "bunx drizzle-kit --config ./drizzle.config.ts generate",
        "db:migrate": "bunx drizzle-kit --config ./drizzle.config.ts migrate",
        "dev": "bun run --watch .",
        "dev:on": "bun run aux:on && bun run app:on",
        "dev:off": "bun run app:off && bun run aux:off",
        "aux:on": "docker compose --env-file ./.env -f ./docker-compose-dev.yml --profile aux up --build -d --remove-orphans ",
        "aux:off": "docker compose -f ./docker-compose-dev.yml --profile aux down --remove-orphans",
        "app:on": "docker compose --env-file ./.env -f ./docker-compose-dev.yml --profile app up --build  --remove-orphans ",
        "app:off": "docker compose -f ./docker-compose-dev.yml --profile app down --remove-orphans",
        "build": "tsc",
        "format": "prettier --write \"src/**\"",
        "check": "bun run format && bun run build"
    },
    "prettier": {
        "endOfLine": "lf",
        "printWidth": 150,
        "bracketSpacing": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "useTabs": false,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2,
                    "useTabs": false
                }
            }
        ]
    },
    "private": true
}
