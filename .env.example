# Tokens
DISCORD_TOKEN=
DBUSERNAME=USERNAME
DBPASSWORD=PASSWORD
MONGO_URI=mongodb://${DBUSERNAME}:${DBPASSWORD}@mongo:27017/&CLIENT_ID?authSource=admin #&CLIENT_ID will be replaced with the client id
PREFIX=,
DEBUG_LEVEL=4 # 0: None, 1: Fatal, 2: Error, 3: Warning, 4: Info, 5: Debug, 6: Trace
WATCHDOG_LEVEL=3 # 0: None, 1: Fatal, 2: Error, 3: Warning, 4: Info, 5: Debug, 6: Trace
SUGGESTION_CHANNEL_ID= # The channel id where the suggestions will be sent
LOG_TO_FILE=false
STEAM_API= # Get a steam web api key
OLLAMA_API_ENDPOINT= # Optional Ollama API endpoint, e.g. http://localhost:11434, for some fun features
OLLAMA_MODEL=mistral-nemo:12b # Recommended model, but any on ollama really works.